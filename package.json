{
  "name": "chaltteok-frontend",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:user": "turbo dev --filter=@chaltteok/user",
    "dev:owner": "turbo dev --filter=@chaltteok/owner",
    "dev:admin": "turbo dev --filter=@chaltteok/admin",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2",
    "husky": "^9",
    "lint-staged": "^16"
  }
}
